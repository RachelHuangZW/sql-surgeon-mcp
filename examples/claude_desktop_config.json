{
  "mcpServers": {
    "sql-surgeon-mcp": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/path/to/sql-surgeon-mcp",
        "python",
        "-m",
        "sql_surgeon_mcp.server"
      ],
      "env": {
        "DATABASE_URL": "postgresql://user:password@localhost:5432/dbname",
        "SURGEON_READONLY_DATABASE_URL": "postgresql://sql_surgeon_readonly:password@localhost:5432/dbname"
      }
    }
  }
}
